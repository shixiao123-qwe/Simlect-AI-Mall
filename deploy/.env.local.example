# Local demo only. Copy to deploy/.env.local and fill in the two API keys.
# KEY=value, one entry per line. Do not append inline comments to values.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# For Responses-compatible providers: set true and include /v1 in LLM_BASE_URL.
LLM_USE_RESPONSES_API=false
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
# Keep 1024 dimensions to match the existing Java/Elasticsearch index.
EMBEDDING_DIMENSIONS=1024
SIMLECT_INTERNAL_TOKEN=
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=SimlectDev_2026!Mall
MYSQL_USER=root
MYSQL_PASSWORD=root
RABBIT_USER=simlect
RABBIT_PASSWORD=simlect
SIMLECT_MAIL_LOCAL_MOCK_ENABLED=true
# Local payment placeholder only: creates unpaid orders, never charges or marks them paid.
SIMLECT_PAY_LOCAL_MOCK_ENABLED=true
# Optional executable paths if the commands are not on PATH. No quotes needed.
LOCAL_JAVA_EXE=
LOCAL_MAVEN_CMD=
LOCAL_NODE_EXE=
LOCAL_NPM_CMD=
LOCAL_PYTHON_EXE=
# Optional existing upload directory; blank uses project-local local-data/upload/.
PROJECT_FOLDER=E:/Simlect-AI-Mall-main/local-data/upload/

# Local demo: keyword product search and GPT tools remain enabled.
VECTOR_SEARCH_ENABLED=false

# Explicit local-only payment simulation; no real money is transferred.
SIMLECT_PAY_DEMO_CONFIRM_ENABLED=true

# Local after-sale fulfillment. Demo return address is NOT a real shipping destination.
SIMLECT_AFTER_SALE_REFUND_ENABLED=true
AFTER_SALE_RETURN_ADDRESS=本地演示仓库（仅测试，请勿寄送真实包裹）
